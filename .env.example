# Copy to `.env` (or export in your shell). EVERY value below is OPTIONAL -
# the app runs with sensible defaults and creates its own database on first launch.
#
# `.env` itself is git-ignored; this example file is committed so others can
# discover the available knobs. Never put real credentials or personal data here.

# ---------------------------------------------------------------------------
# V2 (current) - backend\app2
# ---------------------------------------------------------------------------

# SQLite file path. Default: <user data dir>\tradequest_v2.db
# On a normal install the data dir is %LOCALAPPDATA%\TradeQuest
# TRADEQUEST2_DB=data/tradequest_v2.db

# Point at an existing database instead of a file (takes precedence over the above)
# TRADEQUEST2_DB_URL=

# Backend port. Default: 8001 (binds to 127.0.0.1 only)
# TRADEQUEST2_PORT=8001

# Comma-separated CORS origins for the API
# TRADEQUEST2_CORS=http://localhost:5173,http://127.0.0.1:5173

# Directory of built frontend assets to serve (desktop/frozen builds)
# TRADEQUEST2_STATIC_DIR=frontend_v2/dist

# Screenshot smoke-test: directories the capture script may write into
# TRADEQUEST2_SCREENSHOT_DIRS=

# ---------------------------------------------------------------------------
# V1 (legacy) - backend\app
# ---------------------------------------------------------------------------

# SQLite database file. Default: data/tradequest.db
# TRADEQUEST_DB=data/tradequest.db

# Seed workbook for the one-time initial import (never committed - personal data)
# TRADEQUEST_EXCEL=Trading Journla-Reaction Based Strategy.xlsx

# Allowed CORS origins for the API (comma separated)
# TRADEQUEST_CORS=http://localhost:5173,http://127.0.0.1:5173